rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        request.auth.uid == get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId ||
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
      );
    }

    // Organization Root Collection
    match /organizations/{orgId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isOrgMember(orgId));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Subcollections under Organization (Isolated per Tenant)
      match /sales/{saleId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /products/{productId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /customers/{customerId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /suppliers/{supplierId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /ledgerEntries/{entryId} {
        allow read: if isOrgMember(orgId);
        // Ledger entries are immutable once written
        allow create: if isOrgMember(orgId);
        allow update, delete: if false;
      }
    }
  }
}
