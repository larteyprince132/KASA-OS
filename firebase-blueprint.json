{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant business account entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "industry", "currency", "ownerId"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Commercial customer sale and invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceAmount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "orgId", "invoiceNumber", "totalAmount", "paidAmount", "balanceAmount"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "purchaseCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "minReorderPoint": { "type": "number" }
      },
      "required": ["id", "orgId", "sku", "name", "purchaseCost", "sellingPrice"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Trade customer account with receivables tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "outstandingBalance": { "type": "number" },
        "totalPurchases": { "type": "number" }
      },
      "required": ["id", "orgId", "name", "outstandingBalance"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable double-entry general ledger journal row",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "transactionId": { "type": "string" },
        "accountCode": { "type": "string" },
        "accountName": { "type": "string" },
        "debit": { "type": "number" },
        "credit": { "type": "number" },
        "reference": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "orgId", "transactionId", "accountCode", "debit", "credit"]
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Organization tenant root"
    },
    "/organizations/{orgId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Customer sales and invoices"
    },
    "/organizations/{orgId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog products and stock levels"
    },
    "/organizations/{orgId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer accounts and debtor balances"
    },
    "/organizations/{orgId}/ledgerEntries/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Immutable double-entry journal rows"
    }
  }
}
